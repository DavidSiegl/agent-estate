# Merges a pull request into main, with a merge commit, once the quality gate has passed
# on its head commit, so a pull request lands without a human. Any file may change, as in
# octoflow-ai's auto-merge (decided by agent-estate's owner on 2026-11-05). So an agent's pull request
# is trusted not to loosen its own check, which CI runs from the pull request's own copy of
# the files that configure it (CI's files, scripts/gate,{% if release %} scripts/release,{% endif %} conftest.py, pytest's,
# coverage's and ruff's configuration, uv.lock), and not to loosen the check of every later one by
# changing those files or this workflow on main. Held for a human: drafts, and pull
# requests labelled no-automerge, from forks, or into another branch.
#
# A pull request behind main is brought up to date instead (GitHub's update-branch merges
# main into it), and CI's check of its new head decides, as for any push. The ci-cd ruleset
# requires that check on a head up to date with main (init/github-rules.py), so of two pull
# requests that passed at the same moment GitHub merges only the first and refuses the
# second, which auto-merge then updates{% if release %}: should both raise to the same version, the
# second's new run fails CI's Version check, so it never merges to go unreleased{% endif %}. A pull
# request that conflicts with main fails the run and waits for a human.
#
# GitHub runs this from main's copy for {% if ci == 'jenkins' %}status{% else %}workflow_run{% endif %} events, so a pull request cannot change
# these rules for itself. {% if ci == 'jenkins' %}It trusts a success only from Jenkins's GitHub App
# ({{ jenkins_status_login }}), which the agents' own token cannot post as.{% else %}It acts only on a Gate run of this repository's.{% endif %}
#
# It acts with AUTOMERGE_TOKEN, a fine-grained personal access token of the repository's
# owner limited to this repository, with contents, pull requests and workflows read and
# write. Not github.token: GitHub refuses that token a merge that changes .github/workflows/,
# and starts no workflow for a push made with it: neither the merge's to main nor an
# update's to a pull request's branch. When the
# secret is missing or the token has expired, every run fails at its first gh call and
# pull requests wait for a human until it is replaced.
name: Auto-merge

on:
{%- if ci == 'jenkins' %}
  status
{%- else %}
  workflow_run:
    workflows: [Gate]
    types: [completed]
{%- endif %}

permissions: {}

jobs:
  merge:
{%- if ci == 'jenkins' %}
    if: >-
      github.event.state == 'success' &&
      github.event.context == 'continuous-integration/jenkins/pr-head' &&
      github.event.sender.login == '{{ jenkins_status_login }}'
{%- else %}
    if: >-
      github.event.workflow_run.conclusion == 'success' &&
      github.event.workflow_run.event == 'pull_request'
{%- endif %}
    runs-on: ubuntu-latest
    # No concurrency group: one would cancel a queued run when a third arrives, leaving a
    # passed pull request unmerged. gh pr merge --match-head-commit makes parallel runs safe.
    steps:
      - shell: bash
        env:
          GH_TOKEN: {% raw %}${{ secrets.AUTOMERGE_TOKEN }}{% endraw %}
          GH_REPO: {% raw %}${{ github.repository }}{% endraw %}
          SHA: {% raw %}${{ {% endraw %}{% if ci == 'jenkins' %}github.event.sha{% else %}github.event.workflow_run.head_sha{% endif %}{% raw %} }}{% endraw %}
        run: |
          # 1 when a pull request may have passed but was neither merged nor updated: a call failed.
          failed=0
          # The number of commits on main that $SHA does not contain.
          behind_main() {
            gh api "repos/$GH_REPO/compare/main...$SHA" --jq .behind_by
          }
          # Every open pull request whose head is the commit that passed.
          if ! prs=$(gh api "repos/$GH_REPO/commits/$SHA/pulls" --jq '.[] | select(.state == "open") | .number'); then
            echo "::error::could not list the pull requests at $SHA"
            exit 1
          fi
          for pr in $prs; do
            if ! fields=$(gh pr view "$pr" \
              --json headRefOid,headRefName,baseRefName,isDraft,isCrossRepository,labels \
              --jq '[.headRefOid, .headRefName, .baseRefName, .isDraft, .isCrossRepository,
                     any(.labels[]; .name == "no-automerge")] | @tsv'); then
              echo "::error::#$pr: could not read it"
              failed=1
              continue
            fi
            IFS=$'\t' read -r head branch base draft fork held <<<"$fields"
            if [ "$head" != "$SHA" ]; then
              echo "#$pr: its head moved on from $SHA; that commit's own check decides"
              continue
            elif [ "$base" != main ] || [ "$draft" = true ] || [ "$fork" = true ] || [ "$held" = true ]; then
              echo "#$pr: held (base $base, draft $draft, fork $fork, no-automerge $held)"
              continue
            fi
            if ! behind=$(behind_main); then
              echo "::error::#$pr: could not compare $SHA with main"
              failed=1
              continue
            fi
            if [ "$behind" = 0 ]; then
              if gh pr merge "$pr" --merge --match-head-commit "$SHA"; then
                echo "#$pr: merged"
                gh api --method DELETE "repos/$GH_REPO/git/refs/heads/$branch" ||
                  echo "::warning::#$pr: merged, but its branch $branch was not deleted"
                continue
              fi
              # The ruleset refuses a merge once main has moved on, as when another pull
              # request merged since the comparison above: then it needs the update below.
              if ! behind=$(behind_main) || [ "$behind" = 0 ]; then
                echo "::error::#$pr: merge failed"
                failed=1
                continue
              fi
            fi
            if gh api --method PUT "repos/$GH_REPO/pulls/$pr/update-branch" \
                 -f expected_head_sha="$SHA" >/dev/null; then
              echo "#$pr: $behind commits behind main; updated, and the check of its new head decides"
            else
              echo "::error::#$pr: $behind commits behind main, and updating it failed (a conflict waits for a human)"
              failed=1
            fi
          done
          exit "$failed"
