# Runs the quality gate (scripts/gate) on every pull request into main, and fails on
# GATE: ERROR or when the gate could not judge. Its job, gate, is the check the main
# ruleset requires and auto-merge waits for. ready_for_review and unlabeled rerun it so
# that a pull request released from a hold (docs/agents/README.md) gets a fresh run to
# merge on.
{%- if release %}
#
# With releases it also runs on each push to main, as Jenkins builds main: one run at a
# time in push order, the gate judging everything since the last run on main that passed,
# and only once it passes does the release job release a version that has no release yet
# (scripts/release says what and when). So a push that failed the gate is judged again with
# the next, and never released unjudged. On a pull request, the gate job also checks the
# version raise and runs the repo's scripts/package (steps Version and Package).
{%- endif %}
name: Gate

on:
  pull_request:
    branches: [main]
    types: [opened, synchronize, reopened, ready_for_review, unlabeled]
{%- if release %}
  push:
    branches: [main]
{%- endif %}

permissions:
  contents: read
{%- if release %}

# Runs on main one at a time, so two cannot both find a version unreleased and race to
# release it. GitHub keeps one waiting run and cancels any older waiting one: of several
# pushes arriving while a run is busy, only the last runs, judging the others' commits with
# it (GATE_BASE), and a version raised and raised again meanwhile goes out as the second
# alone. Pull request runs are not grouped.
concurrency:
  group: {% raw %}${{ github.event_name == 'push' && 'main' || github.run_id }}{% endraw %}
  cancel-in-progress: false
{%- endif %}

jobs:
  gate:
    runs-on: ubuntu-latest
    timeout-minutes: 60
{%- if release %}
    permissions:
      contents: read
      # gh run list, for the last run on main that passed.
      actions: read
{%- endif %}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
{%- if gate == 'python' %}
      - uses: astral-sh/setup-uv@1c37ad07a6a961277cf70c0d37d6f313000f5884 # v10.3.0
      # The gate lints the workflows it finds with actionlint, which the runner lacks.
      - name: Install actionlint
        run: |
          version=1.7.12
          sha256=8aca8db96f1b94770f1b0d72b6dddcb1ebb8123cb3712530b08cc387b349a3d8
          tarball="$RUNNER_TEMP/actionlint.tar.gz"
          curl -fsSL "https://github.com/rhysd/actionlint/releases/download/v$version/actionlint_${version}_linux_amd64.tar.gz" -o "$tarball"
          echo "$sha256  $tarball" | sha256sum --check --status
          mkdir -p "$RUNNER_TEMP/bin"
          tar -xzf "$tarball" -C "$RUNNER_TEMP/bin" actionlint
          echo "$RUNNER_TEMP/bin" >> "$GITHUB_PATH"
{%- endif %}
      # The change this run judges, from GATE_BASE to HEAD: a pull request's since it left
      # main{% if release %}; a push's since the head of the last run on main that passed, as
      # Jenkins's GIT_PREVIOUS_SUCCESSFUL_COMMIT. When there is no such run (a new repo, the
      # gate newly added, or its runs expired) or its head is gone, it is everything a release
      # would ship: since the latest v* release tag on HEAD's parent, not on HEAD, whose own
      # tag (publish tags main's head) would leave nothing to judge; else since a commit of
      # the empty tree, made here and never pushed, so a repo's first release is judged
      # whole, tests included. A git failure fails the step rather than read as "no
      # tag"{% endif %}.
      - name: Change
        env:
          PR_BASE: {% raw %}${{ github.event.pull_request.base.sha }}{% endraw %}
{%- if release %}
          GH_TOKEN: {% raw %}${{ github.token }}{% endraw %}
{%- endif %}
        run: |
{%- if release %}
          if [ -n "$PR_BASE" ]; then
            base=$(git merge-base HEAD "$PR_BASE")
          else
            passed=$(gh run list --workflow gate.yml --branch main --event push --status success \
              --limit 1 --json headSha --jq '.[0].headSha // ""')
            if [ -n "$passed" ] && git cat-file -e "$passed^{commit}" 2>/dev/null; then
              base=$passed
            else
              released=
              if git cat-file -e 'HEAD^1^{commit}' 2>/dev/null; then
                tags=$(git tag --list 'v[0-9]*' --merged 'HEAD^1')
                if [ -n "$tags" ]; then
                  released=$(git describe --tags --abbrev=0 --match 'v[0-9]*' 'HEAD^1')
                fi
              fi
              if [ -n "$released" ]; then
                base=$(git rev-parse "$released^{commit}")
              else
                empty=$(git hash-object -w -t tree /dev/null)
                base=$(git -c user.name=gate -c user.email=gate@localhost -c commit.gpgSign=false \
                  commit-tree "$empty" -m empty </dev/null)
              fi
            fi
          fi
{%- else %}
          base=$(git merge-base HEAD "$PR_BASE")
{%- endif %}
          echo "GATE_BASE=$base" >> "$GITHUB_ENV"
      - name: Gate
        run: scripts/gate "$GATE_BASE"
{%- if release %}
      # A pull request must raise the release version over its base branch's, unless it
      # changes only exempt paths (scripts/release's header).
      - name: Version
        if: github.event_name == 'pull_request'
        env:
          TARGET: {% raw %}${{ github.base_ref }}{% endraw %}
        run: scripts/release raised "$TARGET"
      # The repo's own scripts/package, on a pull request that touches a released path, so
      # one that breaks the build fails before it is merged and a change to docs alone
      # builds nothing. The release job runs it itself on main when it releases.
      - name: Package
        if: github.event_name == 'pull_request' && hashFiles('scripts/package') != ''
        run: |
          status=0
          scripts/release changed "$GATE_BASE" || status=$?
          case $status in
            0) scripts/package ;;
            1) echo 'Only exempt paths changed: nothing to package.' ;;
            *) echo "scripts/release changed failed (exit status $status)" >&2; exit 1 ;;
          esac
{%- endif %}
      - name: Report
        if: always()
        run: if [ -f quality.md ]; then cat quality.md >> "$GITHUB_STEP_SUMMARY"; fi
{%- if release %}

  # Releases a push to main whose version has no release yet, packaging it first; any other
  # push finds its release there and builds nothing (scripts/release due and publish). It
  # releases with the workflow's own token, so it needs no secret: a merge auto-merge makes
  # with AUTOMERGE_TOKEN starts this workflow as any push does, which one made with that
  # token itself would not. scripts/package runs in a step with no token in its environment,
  # since packaging runs build tools and their dependencies; that keeps the token out of its
  # environment only, not out of its reach (scripts/release's header, publish). The
  # workflow's concurrency group keeps releases in push order.
  release:
    needs: gate
    if: github.event_name == 'push'
    runs-on: ubuntu-latest
    timeout-minutes: 60
    permissions:
      contents: write
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
          # Else the token sits in .git/config, where scripts/package could read it.
          persist-credentials: false
{%- if gate == 'python' %}
      - uses: astral-sh/setup-uv@1c37ad07a6a961277cf70c0d37d6f313000f5884 # v10.3.0
{%- endif %}
      - name: Due
        id: due
        env:
          GH_TOKEN: {% raw %}${{ github.token }}{% endraw %}
        run: |
          status=0
          scripts/release due || status=$?
          case $status in
            0) echo due=true >> "$GITHUB_OUTPUT" ;;
            1) echo due=false >> "$GITHUB_OUTPUT" ;;
            *) echo "scripts/release due failed (exit status $status)" >&2; exit 1 ;;
          esac
      - name: Package
        if: steps.due.outputs.due == 'true' && hashFiles('scripts/package') != ''
        run: scripts/package
      - name: Publish
        if: steps.due.outputs.due == 'true'
        env:
          GH_TOKEN: {% raw %}${{ github.token }}{% endraw %}
        run: scripts/release publish
{%- endif %}
