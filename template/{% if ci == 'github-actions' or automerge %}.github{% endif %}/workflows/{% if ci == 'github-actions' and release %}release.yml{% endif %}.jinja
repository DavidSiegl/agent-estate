# Releases each push to main whose version has no GitHub release yet, packaging it first;
# any other push finds its release there and builds nothing (scripts/release says what and
# when). A merge auto-merge makes with AUTOMERGE_TOKEN triggers it like any push; one made
# with the workflow's own GITHUB_TOKEN would not.
#
# scripts/package runs in a step with no token in its environment, since packaging runs
# build tools and their dependencies; that keeps the token out of its environment only,
# not out of its reach (scripts/release's header, publish).
#
# One run at a time: two runs cannot both find a version unreleased and race to release
# it. GitHub keeps one waiting run and cancels any older waiting one, so of several pushes
# arriving while a release runs, only the last is judged: a version raised and raised
# again before the first is released goes out as the second alone.
name: Release

on:
  push:
    branches: [main]

permissions:
  contents: write

concurrency:
  group: release
  cancel-in-progress: false

jobs:
  release:
    runs-on: ubuntu-latest
    timeout-minutes: 60
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
          # Else the token sits in .git/config, where scripts/package could read it.
          persist-credentials: false
{%- if gate == 'python' %}
      - uses: astral-sh/setup-uv@1c37ad07a6a961277cf70c0d37d6f313000f5884 # v10.3.0
{%- endif %}
      - name: Due
        id: due
        env:
          GH_TOKEN: {% raw %}${{ github.token }}{% endraw %}
        run: |
          status=0
          scripts/release due || status=$?
          case $status in
            0) echo due=true >> "$GITHUB_OUTPUT" ;;
            1) echo due=false >> "$GITHUB_OUTPUT" ;;
            *) echo "scripts/release due failed (exit status $status)" >&2; exit 1 ;;
          esac
      - name: Package
        if: steps.due.outputs.due == 'true' && hashFiles('scripts/package') != ''
        run: scripts/package
      - name: Publish
        if: steps.due.outputs.due == 'true'
        env:
          GH_TOKEN: {% raw %}${{ github.token }}{% endraw %}
        run: scripts/release publish
